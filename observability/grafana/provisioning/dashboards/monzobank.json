{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Requests per second (all services)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        { "expr": "sum by (service) (rate(http_requests_total[$__rate_interval]))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "title": "p95 latency per service (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "title": "HTTP 5xx error rate per service (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "drawStyle": "bars", "fillOpacity": 40 } },
        "overrides": []
      },
      "targets": [
        { "expr": "sum by (service) (rate(http_requests_total{status=~\"5..\"}[$__rate_interval])) / clamp_min(sum by (service) (rate(http_requests_total[$__rate_interval])), 0.0001) * 100", "legendFormat": "{{service}}" }
      ]
    },
    {
      "title": "Card authorization decisions (5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 40 } },
        "overrides": []
      },
      "targets": [
        { "expr": "sum by (outcome) (increase(card_authorization_decisions_total[$__rate_interval]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "title": "Authorization endpoint latency p95 (card-service)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"card-service\", route=\"/v1/cards/:id/authorize\"}[$__rate_interval]))) * 1000", "legendFormat": "p95" }
      ]
    },
    {
      "title": "Top endpoints by request rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "expr": "topk(8, sum by (route, service) (rate(http_requests_total[$__rate_interval])))", "legendFormat": "{{service}} {{route}}" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["monzobank"],
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "label": "Data source"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "title": "MonzoBank Platform",
  "uid": "monzobank-platform",
  "version": 1
}
